# Zugang zum Hetzner-Webhosting (Tarif L/XL), für scripts/map-upload.sh und später scripts/deploy.sh.
# Kopieren nach deploy.env und ausfüllen. deploy.env wird nicht committet.
# Die Daten stehen in konsoleH unter Einstellungen → Logindaten → FTP-Hauptbenutzer.

LEONIDA_SSH_HOST=wwwXXX.your-server.de
LEONIDA_SSH_USER=benutzername
# Hetzner-Webhosting nutzt Port 222, nicht 22
LEONIDA_SSH_PORT=222
# Absoluter Pfad des Leonida-Ordners auf dem Server (darin: releases/, current, shared/)
LEONIDA_REMOTE_DIR=/usr/home/benutzername/leonida
