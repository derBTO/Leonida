# Leonida – Konfiguration (Laravel). Auf dem Server liegt die echte Datei unter shared/.env.
# Diese Vorlage enthält keine Geheimnisse. Erläuterungen: docs/INSTALLATION.md

APP_NAME=Leonida
APP_ENV=production
APP_DEBUG=false
# Wird bei der Installation mit `php artisan key:generate --show` erzeugt
APP_KEY=
APP_URL=https://leonida.derbto.de
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# PostgreSQL aus dem Hetzner-Webhosting
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
MAIL_MAILER=log

# Erster Administrator. Das Passwort wird nur beim ersten Deployment verwendet, muss
# mindestens 10 Zeichen haben und beim ersten Anmelden geändert werden. Danach leeren.
LEONIDA_ADMIN_USERNAME=BTO
LEONIDA_ADMIN_INITIAL_PASSWORD=

# Ablage außerhalb der Releases (absolute Pfade auf dem Server)
LEONIDA_UPLOAD_DIR=/usr/home/benutzername/leonida/shared/uploads
LEONIDA_MAP_DIR=/usr/home/benutzername/leonida/shared/map
LEONIDA_BACKUP_DIR=/usr/home/benutzername/leonida/shared/backups

# Upload-Grenze pro Bild in MB (PHP upload_max_filesize/post_max_size müssen passen)
LEONIDA_UPLOAD_MAX_MB=20
