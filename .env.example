# Leonida – Konfiguration der Anwendung (Laravel).
# Auf dem Server liegt die echte Datei unter shared/.env. Diese Vorlage enthält keine Geheimnisse.
# Wird in Phase 1 (Laravel-Grundgerüst) um die übrigen Laravel-Schlüssel ergänzt.

APP_NAME=Leonida
APP_ENV=production
APP_DEBUG=false
APP_URL=https://leonida.derbto.de
APP_LOCALE=de
# Wird bei der Installation mit `php artisan key:generate` erzeugt
APP_KEY=

# PostgreSQL aus dem Hetzner-Webhosting
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Erster Administrator. Das Passwort wird nur beim ersten Start verwendet und muss
# danach in der Oberfläche geändert werden. Danach hier wieder leeren.
LEONIDA_ADMIN_USERNAME=BTO
LEONIDA_ADMIN_INITIAL_PASSWORD=

# Ablage außerhalb der Releases (absolute Pfade)
LEONIDA_UPLOAD_DIR=/usr/home/benutzername/leonida/shared/uploads
LEONIDA_MAP_DIR=/usr/home/benutzername/leonida/shared/map
LEONIDA_BACKUP_DIR=/usr/home/benutzername/leonida/shared/backups

# Upload-Grenzen
LEONIDA_UPLOAD_MAX_MB=20
